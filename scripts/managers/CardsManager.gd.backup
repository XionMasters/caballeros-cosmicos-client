# CardsManager.gd
# Manager para obtener cartas desde la API, descargar y cachear imágenes
# Compatible Godot 4.5
extends Node

class_name CardsManager

# -------------------------
# Señales
# -------------------------
signal cards_loaded(cards: Array)
signal card_image_loaded(card_id: String, texture: ImageTexture)
signal card_back_loaded(texture: ImageTexture)
signal deck_images_preloaded()
signal error_occurred(message: String)

# -------------------------
# Config
# -------------------------
@export var API_URL: String = "https://example.com/api"  # Reemplazar por GameConfig.API_URL si existe
@export var MAX_DOWNLOAD_CONCURRENCY: int = 6            # Límite de descargas paralelas

# -------------------------
# Estado interno / cache
# -------------------------
var _http_request: HTTPRequest = null
var _image_cache: Dictionary = {}       # card_id -> ImageTexture
var _card_back_texture: ImageTexture = null
var _is_loading_card_back: bool = false

# Cola para descargas: elementos = { card_id, url, callback }
var _pending_queue: Array = []
var _active_downloads: int = 0

# Contador para preloads
var _pending_deck_images: int = 0

# -------------------------
# Utiles
# -------------------------
func _ready():
	# HTTPRequest dedicado para llamadas JSON sencillas (no imágenes)
	_http_request = HTTPRequest.new()
	add_child(_http_request)
	_http_request.request_completed.connect(_on_json_request_completed)
	# Nada más en ready


# -------------------------
# HTTPS - JSON helpers
# -------------------------
# Nota: callbacks opcionales deben ser Callable() por defecto y comprobamos .is_valid()
func _http_get_json(url: String, callback: Callable = Callable()) -> void:
	# Crea un HTTPRequest temporal para esta llamada (permite concurrencia separada)
	var req: HTTPRequest = HTTPRequest.new()
	add_child(req)
	
	req.timeout = 10.0
	req.request_completed.connect(
		func(result: int, response_code: int, headers: PackedStringArray, body: PackedByteArray, _url = url, _cb = callback, _req = req):
			_handle_json_response(_url, _cb, _req, result, response_code, headers, body)
	)
	
	var err = req.request(url)
	if err != OK:
		_req_failed("HTTP request failed", callback, req)


func _handle_json_response(url: String, callback: Callable, request: HTTPRequest, result: int, response_code: int, _headers, body: PackedByteArray) -> void:
	# Limpieza temprana del request (lo hacemos al final pero podemos cerrarlo si hay error)
	if response_code != 200:
		var msg = "HTTP error %s for %s" % [str(response_code), url]
		_emit_error(msg, callback)
		request.queue_free()
		return
	
	var text = body.get_string_from_utf8()
	var json = JSON.parse_string(text)
	if json.error != OK:
		_emit_error("JSON parse error for %s" % url, callback)
		request.queue_free()
		return
	
	var data = json.result
	# Llamar callback si existe
	if callback and callback.is_valid():
		callback.call(data)
	
	request.queue_free()


func _on_json_request_completed(result: int, response_code: int, headers: PackedStringArray, body: PackedByteArray) -> void:
	# Handler genérico en caso que uses _http_request, pero preferimos el handler inline.
	# Solo lo dejamos para compatibilidad
	pass


func _req_failed(msg: String, callback: Callable, request: HTTPRequest) -> void:
	_emit_error(msg, callback)
	if request and is_instance_valid(request):
		request.queue_free()


func _emit_error(msg: String, callback: Callable = Callable()) -> void:
	push_error("CardsManager: " + msg)
	emit_signal("error_occurred", msg)
	if callback and callback.is_valid():
		callback.call({"error": msg})


# -------------------------
# API - obtener cartas
# -------------------------
func fetch_all_cards(callback: Callable = Callable()) -> void:
	var url = API_URL.rstrip("/") + "/cards"
	_http_get_json(url, callback)


func fetch_cards_by_rarity(rarity: String, callback: Callable = Callable()) -> void:
	# No usamos URI.encode; si necesitás encoding fuerte, hacelo manualmente
	var url = API_URL.rstrip("/") + "/cards?rarity=" + rarity
	_http_get_json(url, callback)


func fetch_user_cards(callback: Callable = Callable()) -> void:
	# Requiere headers auth; prefiero que el caller pase headers si tiene AuthManager
	var url = API_URL.rstrip("/") + "/user-cards"
	_http_get_json(url, callback)


# -------------------------
# IMAGENES - descarga con cola y concurrencia controlada
# -------------------------
func fetch_card_image(card_id: String, image_url: String, callback: Callable = Callable()) -> void:
	"""
	Descarga la imagen de la carta si no está en cache.
	callback opcional: Callable(data) donde data = { card_id, texture } o { error }
	"""
	if card_id == "" or image_url == "":
		_emit_error("fetch_card_image: card_id or image_url empty", callback)
		return
	
	# Si ya está cacheada, emitir y llamar callback
	if _image_cache.has(card_id):
		var texture = _image_cache[card_id]
		emit_signal("card_image_loaded", card_id, texture)
		if callback and callback.is_valid():
			callback.call({ "card_id": card_id, "texture": texture })
		return
	
	# Preparar url (si la API_URL incluye /api y image_url es relativo)
	var base = API_URL
	if base.endswith("/api"):
		base = base.substr(0, base.length() - 4)
	var full_url = base.rstrip("/") + "/" + image_url.lstrip("/")
	
	# Encolar la descarga
	_pending_queue.append({
		"card_id": card_id,
		"url": full_url,
		"callback": callback
	})
	_start_next_downloads()


func _start_next_downloads() -> void:
	# Mientras haya slots y items pendientes, iniciar
	while _active_downloads < MAX_DOWNLOAD_CONCURRENCY and _pending_queue.size() > 0:
		var item: Dictionary = _pending_queue.pop_front()
		_start_download_item(item)


func _start_download_item(item: Dictionary) -> void:
	_active_downloads += 1
	
	var card_id: String = item.get("card_id", "")
	var url: String = item.get("url", "")
	var callback: Callable = item.get("callback", Callable())
	
	var req = HTTPRequest.new()
	add_child(req)
	req.timeout = 15.0
	
	# Conectar con closure que pasa el contexto
	req.request_completed.connect(
		func(result: int, response_code: int, headers: PackedStringArray, body: PackedByteArray, _card_id = card_id, _cb = callback, _req = req):
			_handle_image_response(_card_id, _cb, _req, result, response_code, headers, body)
	)
	
	var err = req.request(url)
	if err != OK:
		# fallo al iniciar
		_active_downloads = max(0, _active_downloads - 1)
		_emit_error("Failed to start image request for %s" % card_id, callback)
		req.queue_free()
		# intentar siguiente
		call_deferred("_start_next_downloads")


func _handle_image_response(card_id: String, callback: Callable, request: HTTPRequest, result: int, response_code: int, _headers, body: PackedByteArray) -> void:
	# Siempre liberar el request y decrementar contador
	defer:
		if request and is_instance_valid(request):
			request.queue_free()
		_active_downloads = max(0, _active_downloads - 1)
		call_deferred("_start_next_downloads")
	
	if response_code != 200 or body.size() == 0:
		_emit_error("Image HTTP error %s for %s" % [str(response_code), card_id], callback)
		# emitir señal con null para que quien escucha pueda manejar placeholder
		emit_signal("card_image_loaded", card_id, null)
		if callback and callback.is_valid():
			callback.call({ "card_id": card_id, "texture": null })
		return
	
	# Intentar decodificar imagen
	var image = Image.new()
	var err = OK
	
	# Detección simple de PNG / WebP / JPG
	var is_png = body.size() >= 8 and body[0] == 0x89 and body[1] == 0x50 and body[2] == 0x4E and body[3] == 0x47
	var is_webp = body.size() >= 12 and body[0] == 0x52 and body[1] == 0x49 and body[2] == 0x46 and body[3] == 0x46 and body[8] == 0x57 and body[9] == 0x45 and body[10] == 0x42 and body[11] == 0x50
	# Fallback JPG detection by magic bytes (FF D8)
	var is_jpg = body.size() >= 2 and body[0] == 0xFF and body[1] == 0xD8
	
	if is_png:
		err = image.load_png_from_buffer(body)
	elif is_webp:
		# Nota: Godot soporta webp en load_webp_from_buffer si está compilado con soporte.
		# Si es animado, Godot no devuelve frames animados por defecto; tomamos el primer frame.
		err = image.load_webp_from_buffer(body)
	elif is_jpg:
		err = image.load_from_buffer(body)  # load_from_buffer suele manejar jpeg también
	else:
		# último recurso
		err = image.load_from_buffer(body)
	
	if err != OK:
		_emit_error("Failed to decode image for %s (err=%s)" % [card_id, str(err)], callback)
		emit_signal("card_image_loaded", card_id, null)
		if callback and callback.is_valid():
			callback.call({ "card_id": card_id, "texture": null })
		return
	
	# Crear texture desde image
	var tex = ImageTexture.create_from_image(image)
	_image_cache[card_id] = tex
	
	emit_signal("card_image_loaded", card_id, tex)
	if callback and callback.is_valid():
		callback.call({ "card_id": card_id, "texture": tex })


# -------------------------
# Dorso de carta y preloads
# -------------------------
func preload_card_back(callback: Callable = Callable()) -> void:
	if _card_back_texture:
		emit_signal("card_back_loaded", _card_back_texture)
		if callback and callback.is_valid():
			callback.call(_card_back_texture)
		return
	
	if _is_loading_card_back:
		# Ya en proceso: no duplicar
		# Podríamos guardar callbacks y llamarlos al final; por simplicidad llamamos callback vacío
		if callback and callback.is_valid():
			callback.call(null)
		return
	
	_is_loading_card_back = true
	
	var base = API_URL
	if base.endswith("/api"):
		base = base.substr(0, base.length() - 4)
	var url = base.rstrip("/") + "/assets/cards/card_back.png"
	
	var req = HTTPRequest.new()
	add_child(req)
	req.request_completed.connect(
		func(result: int, response_code: int, headers: PackedStringArray, body: PackedByteArray, _req = req, _cb = callback):
			_on_card_back_response(_req, _cb, result, response_code, headers, body)
	)
	req.request(url)


func _on_card_back_response(request: HTTPRequest, callback: Callable, result: int, response_code: int, _headers, body: PackedByteArray) -> void:
	_is_loading_card_back = false
	
	if response_code != 200 or body.size() == 0:
		_emit_error("Failed to load card back (HTTP %s)" % str(response_code), callback)
		if callback and callback.is_valid():
			callback.call(null)
		emit_signal("card_back_loaded", null)
		if request and is_instance_valid(request):
			request.queue_free()
		return
	
	var image = Image.new()
	var err = image.load_png_from_buffer(body)
	if err != OK:
		_emit_error("Failed to decode card back image", callback)
		emit_signal("card_back_loaded", null)
		if callback and callback.is_valid():
			callback.call(null)
		if request and is_instance_valid(request):
			request.queue_free()
		return
	
	_card_back_texture = ImageTexture.create_from_image(image)
	emit_signal("card_back_loaded", _card_back_texture)
	if callback and callback.is_valid():
		callback.call(_card_back_texture)
	
	if request and is_instance_valid(request):
		request.queue_free()


func preload_deck_images(deck_cards: Array, final_callback: Callable = Callable()) -> void:
	"""
	deck_cards: Array of dictionaries { card_id: String, image_url: String }
	final_callback: Callable() called when all done
	"""
	if deck_cards == null:
		if final_callback and final_callback.is_valid():
			final_callback.call({"error":"no deck_cards"})
		return
	
	# construir lista de items que faltan
	var to_load: Array = []
	for d in deck_cards:
		var cid = d.get("card_id", "")
		var img = d.get("image_url", "")
		if cid == "":
			continue
		if not _image_cache.has(cid):
			to_load.append({ "card_id": cid, "image_url": img })
	
	if to_load.size() == 0:
		# Todo en cache
		emit_signal("deck_images_preloaded")
		if final_callback and final_callback.is_valid():
			final_callback.call({ "status": "cached" })
		return
	
	_pending_deck_images = to_load.size()
	
	# Encolar todos (manteniendo callback que decrementa contador)
	for item in to_load:
		# usar fetch_card_image con callback propio
		var card_id = item.card_id
		var image_url = item.image_url
		
		fetch_card_image(card_id, image_url, Callable(self, "_on_deck_image_cb"))


func _on_deck_image_cb(result: Dictionary) -> void:
	# result expected { card_id, texture } or { error }
	_pending_deck_images = max(0, _pending_deck_images - 1)
	#print("CardsManager: deck preload remaining: ", _pending_deck_images)
	if _pending_deck_images == 0:
		emit_signal("deck_images_preloaded")


# -------------------------
# Acceso a cache
# -------------------------
func get_cached_texture(card_id: String) -> ImageTexture:
	return _image_cache.get(card_id, null)


func has_cached(card_id: String) -> bool:
	return _image_cache.has(card_id)


func get_card_back_texture() -> ImageTexture:
	return _card_back_texture
