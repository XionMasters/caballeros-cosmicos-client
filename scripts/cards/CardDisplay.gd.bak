
# CardDisplay.gd
# Componente visual + entradas del jugador para una carta individual
# Responsabilidad: Mostrar carta y capturar interacción (NO lógica de juego)
extends PanelContainer
class_name CardDisplay

# --- State Machine (Inspirado en Framework) ---
enum DraggableState {
	IDLE,
	HOVERING,
	HOLDING,
	MOVING
}

var current_state: DraggableState = DraggableState.IDLE
var allowed_transitions = {
	DraggableState.IDLE: [DraggableState.HOVERING, DraggableState.HOLDING, DraggableState.MOVING],
	DraggableState.HOVERING: [DraggableState.IDLE, DraggableState.HOLDING, DraggableState.MOVING],
	DraggableState.HOLDING: [DraggableState.IDLE, DraggableState.MOVING],
	DraggableState.MOVING: [DraggableState.IDLE]
}

# State machine properties
var is_mouse_inside: bool = false
var current_holding_mouse_position: Vector2
var original_position: Vector2
var original_scale: Vector2
var original_rotation: float
var original_z: int
var move_tween: Tween = null

# Hover animation properties
@export var hover_distance: int = 30
@export var hover_scale: float = 1.1
@export var hover_rotation: float = 0.0
@export var hover_duration: float = 0.2

# Signals
signal card_clicked(card: CardData)
signal card_double_clicked(card: CardData)
signal drag_started(card: CardData)
signal drag_ended(card: CardData)

var card_image: TextureRect = null
var highlight_overlay: ColorRect = null  # Overlay para highlight (mejor que theme override)

var card_data: CardData
var card_instance: CardInstance = null  # Referencia directa (no metadata)
var instance_id: String = ""  # Cache del ID

var is_hovered: bool = false
var click_timer: Timer
var click_count: int = 0
var disable_hover_animation: bool = false  # Para HandLayout

# Estados separados (no mezclar)
var interaction_enabled: bool = true  # Puede recibir input del usuario
var is_disabled: bool = false  # No se puede usar (falta energía, no es turno)
var is_exhausted: bool = false  # Ya actuó este turno
var is_highlighted: bool = false  # Resaltado como jugable

# Tweens persistentes (evitar fugas)
var hover_tween: Tween = null
var highlight_tween: Tween = null

# Estilos predefinidos
var normal_style: StyleBoxFlat = null
var disabled_style: StyleBoxFlat = null

func _ready():
	_ensure_ui_structure()
	_create_styles()
	
	# Permitir que el PanelContainer reciba eventos (STOP para drag & drop)
	mouse_filter = Control.MOUSE_FILTER_STOP
	print("[DBG] CardDisplay._ready: mouse_filter=", mouse_filter, " class=", get_class())
	
	# CRÍTICO: Todos los hijos deben IGNORAR eventos para que lleguen al PanelContainer
	_set_children_mouse_filter_ignore()
	
	# Conectar hover effects (mouse_entered/exited)
	mouse_entered.connect(play_hover_animation)
	mouse_exited.connect(stop_hover_animation)
	
	# NOTE: gui_input conexión se hace en GameBoard después de instanciar para evitar duplicación
	# NO conectar aquí - HandLayout lo hace para mouse_entered/exited si es necesario
	
	# Timer para detectar doble clic
	click_timer = Timer.new()
	click_timer.wait_time = 0.3
	click_timer.one_shot = true
	add_child(click_timer)
	click_timer.timeout.connect(_on_click_timeout)
	
	# === State Machine Initialization ===
	original_position = position
	original_scale = scale
	original_rotation = rotation
	original_z = z_index
	current_state = DraggableState.IDLE

func _set_children_mouse_filter_ignore():
	"""Configurar IGNORE en todos los hijos recursivamente"""
	var child_count = 0
	for child in get_children():
		if child is Control:
			child.mouse_filter = Control.MOUSE_FILTER_IGNORE
			child_count += 1
			# Recursivo para nietos
			for grandchild in child.get_children():
				if grandchild is Control:
					grandchild.mouse_filter = Control.MOUSE_FILTER_IGNORE
					child_count += 1
	print("CardDisplay: Configurados ", child_count, " nodos hijos con MOUSE_FILTER_IGNORE")

func _create_styles():
	"""Crear estilos visuales predefinidos"""
	# Estilo normal (transparente)
	normal_style = StyleBoxFlat.new()
	normal_style.bg_color = Color(0, 0, 0, 0)
	
	# Estilo deshabilitado
	disabled_style = StyleBoxFlat.new()
	disabled_style.bg_color = Color(0.3, 0.3, 0.3, 0.5)

func _ensure_ui_structure():
	"""Crear solo la imagen de la carta, sin textos ni stats"""
	# Establecer tamaño mínimo del PanelContainer
	custom_minimum_size = Vector2(120, 168)
	
	if has_node("MarginContainer/VBoxContainer/CardImage"):
		card_image = $MarginContainer/VBoxContainer/CardImage
		highlight_overlay = $HighlightOverlay if has_node("HighlightOverlay") else null
		return
	
	# Crear estructura dinámica SOLO imagen
	var margin = MarginContainer.new()
	margin.name = "MarginContainer"
	margin.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(margin)
	margin.add_theme_constant_override("margin_left", 8)
	margin.add_theme_constant_override("margin_top", 8)
	margin.add_theme_constant_override("margin_right", 8)
	margin.add_theme_constant_override("margin_bottom", 8)
	
	var vbox = VBoxContainer.new()
	vbox.name = "VBoxContainer"
	vbox.mouse_filter = Control.MOUSE_FILTER_IGNORE
	margin.add_child(vbox)
	
	card_image = TextureRect.new()
	card_image.name = "CardImage"
	card_image.custom_minimum_size = Vector2(120, 168)  # Proporción 5:7 (estándar cartas)
	card_image.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	card_image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	card_image.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vbox.add_child(card_image)
	
	# Crear overlay para highlight dentro del margin (consistencia visual)
	highlight_overlay = ColorRect.new()
	highlight_overlay.name = "HighlightOverlay"
	highlight_overlay.color = Color(1, 1, 0, 0.3)  # Amarillo semi-transparente
	highlight_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	highlight_overlay.visible = false
	highlight_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	margin.add_child(highlight_overlay)
	highlight_overlay.z_index = 1  # Encima de la imagen

func play_spawn_animation():
	"""Animación de entrada cuando la carta aparece en el tablero"""
	# Estado inicial: invisible y pequeña
	modulate.a = 0.0
	scale = Vector2(0.3, 0.3)
	
	# Animación: fade in + escala con efecto elástico
	var tween = create_tween()
	tween.set_parallel(true)
	tween.tween_property(self, "modulate:a", 1.0, 0.4).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, "scale", Vector2.ONE, 0.5).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func setup(card: CardData):
	"""Configurar carta desde CardData (template estático)"""
	_ensure_ui_structure()
	
	# Asegurar que los estilos existan
	if not normal_style:
		_create_styles()
	
	# Protección extra: crear estilo mínimo si aún es null
	if not normal_style:
		normal_style = StyleBoxFlat.new()
		normal_style.bg_color = Color(0, 0, 0, 0)
	
	card_data = card
	add_theme_stylebox_override("panel", normal_style)
	
	# Asegurar mouse_filter correcto
	_set_children_mouse_filter_ignore()

func setup_from_instance(instance: CardInstance):
	"""Configurar carta desde CardInstance (estado en partida)"""
	if not instance or not instance.base_data:
		return
	
	card_instance = instance
	card_data = instance.base_data
	instance_id = instance.instance_id
	
	# Configurar visual
	setup(card_data)
	update_visual_state()

func set_card_image(texture: ImageTexture):
	"""Método seguro para establecer imagen - con validaciones"""
	if not is_instance_valid(self):
		push_warning("CardDisplay: Instancia no válida al establecer imagen")
		return

	if not card_image:
		# Intentar encontrar la referencia nuevamente
		_ensure_ui_structure()
		if not card_image:
			push_error("CardDisplay: card_image node missing, skipping texture assignment")
			return
	card_image.texture = texture

func _on_gui_input(event: InputEvent):
	print("[DBG] CardDisplay._on_gui_input: event type=", event.get_class(), " interaction_enabled=", interaction_enabled, " is_disabled=", is_disabled)
	# --- State validation handled by change_state method ---
	if not interaction_enabled:
		print("[DBG] CardDisplay: gui_input BLOQUEADO por interaction_enabled=false")
		return
	# --- Global drag flag validation ---
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			if is_disabled:
				print("[DBG] CardDisplay: click ignorado (is_disabled)")
				return
			if MatchManager.card_drag_ongoing != null:
				print("[DBG] CardDisplay: otro drag en curso, ignorando input")
				return
			# Long-press detection for drag
			MatchManager.card_drag_ongoing = self
			change_state(DraggableState.HOVERING)
			await get_tree().create_timer(0.1).timeout
			if MatchManager.card_drag_ongoing == self:
				change_state(DraggableState.HOLDING)
				start_dragging()
		else:
			if MatchManager.card_drag_ongoing == self:
				if current_state == DraggableState.HOLDING:
					stop_dragging()
				else:
					show_card_details()
				MatchManager.card_drag_ongoing = null
			change_state(DraggableState.IDLE)

func _on_click_timeout():
	"""Timeout del clic simple - emitir clic simple"""
	if click_count == 1:
		var _dbg_name_click := card_data.name if card_data else ""
		print("[DBG] CardDisplay: CLICK emit | card=", _dbg_name_click)
		card_clicked.emit(card_data)
	click_count = 0

func _get_drag_data(_at_position: Vector2):
	"""Permite arrastrar la carta"""
	if not can_be_dragged():
		var _dbg_name_drag_reject := card_data.name if card_data else ""
		print("[DBG] CardDisplay: drag RECHAZADO can_be_dragged=false | card=", _dbg_name_drag_reject, " disabled=", is_disabled, " exhausted=", is_exhausted, " interaction_enabled=", interaction_enabled)
		return null
	
	var _dbg_name_drag_start := card_data.name if card_data else ""
	print("[DBG] CardDisplay: drag_started | card=", _dbg_name_drag_start, " instance=", instance_id)
	drag_started.emit(self)
	
	# Reproducir sonido de drag
	if has_node("/root/AudioManager"):
		get_node("/root/AudioManager").play_card_drag()
	
	# CAMBIO: Animar la carta original durante el drag
	# La carta se eleva y escala ligeramente
	var drag_tween = create_tween()
	drag_tween.set_parallel(true)
	drag_tween.tween_property(self, "position:y", position.y - 20, 0.15)  # Elevar 20px
	drag_tween.tween_property(self, "scale", Vector2(1.02, 1.02), 0.15)  # Escala mínima
	drag_tween.tween_property(self, "z_index", 100, 0.15)  # Traer al frente
	
	# Crear preview eficiente (sin duplicar todo el nodo)
	var preview = PanelContainer.new()
	preview.custom_minimum_size = size
	
	var preview_image = TextureRect.new()
	preview_image.texture = card_image.texture
	preview_image.expand_mode = TextureRect.EXPAND_FIT_WIDTH_PROPORTIONAL
	preview_image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	preview_image.set_anchors_preset(Control.PRESET_FULL_RECT)
	preview.add_child(preview_image)
	
	# Sin transparencia (se ve la carta completa)
	preview.modulate.a = 1.0
	# CAMBIO: Escala MÁS CERCANA a la original (1.0 en lugar de 1.1)
	# Ahora la carta original es la que se ve más grande, no el preview
	preview.scale = Vector2(1.0, 1.0)
	
	# Offset para arrastrar desde el centro de la carta
	# El offset negativo coloca el centro del preview en la posición del mouse
	var card_center = size * 0.5
	var preview_center = (size * preview.scale) * 0.5
	preview.position = card_center - preview_center
	
	set_drag_preview(preview)
	
	# Payload del drag
	var drag_data = {
		"card_data": card_data,
		"card_type": card_data.type,
		"card_display": self
	}
	
	# Agregar CardInstance si está disponible
	if card_instance:
		drag_data["card_instance"] = card_instance
		drag_data["instance_id"] = instance_id
	
	return drag_data

func can_be_dragged() -> bool:
	"""Verificar si la carta puede ser arrastrada"""
	return card_data != null and interaction_enabled and not is_disabled and not is_exhausted

func start_dragging():
	"""Iniciar arrastre de la carta"""
	drag_started.emit(card_data)
	print("[DBG] CardDisplay.start_dragging: ", card_data.name if card_data else "unknown")

func stop_dragging():
	"""Detener arrastre y restaurar posición"""
	drag_ended.emit(card_data)
	_restore_card_after_drag()
	print("[DBG] CardDisplay.stop_dragging: ", card_data.name if card_data else "unknown")

func show_card_details():
	"""Mostrar detalles de la carta (para clics sin drag)"""
	card_clicked.emit(card_data)
	print("[DBG] CardDisplay.show_card_details: ", card_data.name if card_data else "unknown")

func _restore_card_after_drag():
	"""Restaurar la carta a su estado original después del drag"""
	var restore_tween = create_tween()
	restore_tween.set_parallel(true)
	restore_tween.tween_property(self, "position:y", position.y + 20, 0.15)  # Bajar a posición original
	restore_tween.tween_property(self, "scale", Vector2.ONE, 0.15)  # Escala normal (1.0)
	restore_tween.tween_property(self, "z_index", 0, 0.15)  # Volver al z_index normal

func is_playable() -> bool:
	"""Verificar si la carta es jugable (útil para GameBoard)"""
	return is_highlighted and not is_disabled and not is_exhausted

func get_highlighted() -> bool:
	"""Obtener estado de highlight"""
	return is_highlighted

func update_from_instance(instance: CardInstance):
	"""Actualizar visualización desde CardInstance (para stats modificados)"""
	if not instance:
		return
	
	var needs_update = false
	
	# Solo actualizar si hay cambios reales (dirty flag pattern)
	if card_instance != instance:
		card_instance = instance
		instance_id = instance.instance_id
		needs_update = true
	
	# Verificar cambios específicos
	if instance.has("is_exhausted") and instance.is_exhausted != is_exhausted:
		set_exhausted(instance.is_exhausted)
		needs_update = true
	
	if instance.has("mode") and needs_update:
		update_mode_visual(instance.mode)
	
	if needs_update:
		update_stats_display()

func update_visual_state():
	"""Método maestro para actualizar TODO el estado visual"""
	# Aplicar estados
	if is_disabled:
		add_theme_stylebox_override("panel", disabled_style)
		modulate = Color(0.6, 0.6, 0.6, 1.0)
	else:
		add_theme_stylebox_override("panel", normal_style)
		modulate = Color(1, 1, 1, 1)
	
	# Exhausted state
	if is_exhausted:
		modulate = Color(0.7, 0.7, 0.7, 0.8)
		# Rotar solo la imagen, no el contenedor
		if card_image:
			card_image.rotation_degrees = 15
	else:
		if card_image:
			card_image.rotation_degrees = 0
	
	# Highlight overlay
	if highlight_overlay:
		highlight_overlay.visible = is_highlighted
		if is_highlighted:
			_start_highlight_pulse()
		else:
			_stop_highlight_pulse()
	
	# Stats display
	update_stats_display()

func update_stats_display():
	"""Actualizar visualización de stats desde CardInstance"""
	if not card_instance:
		return
	
	# TODO: Implementar dirty flag cuando CardInstance lo tenga
	# if card_instance.stats_dirty:
	#     ... actualizar stats ...
	#     card_instance.stats_dirty = false
	
	# TODO: Cuando tengamos overlay de stats, actualizar aquí
	# Por ahora solo actualizamos metadata
	# Ejemplo para futuro:
	# if stats_label:
	#     stats_label.text = "%d/%d/%d" % [
	#         card_instance.current_attack,
	#         card_instance.current_defense,
	#         card_instance.current_health
	#     ]

func update_mode_visual(_mode: String):
	"""Actualizar visual según modo de combate"""
	# TODO: Implementar cuando tengamos indicadores visuales
	# Ejemplos:
	# - Modo ataque: borde rojo
	# - Modo defensa: borde azul
	# - Modo evasión: borde verde
	pass

# ========================================
# MÉTODOS DE INTERACCIÓN
# ========================================

func enable_interaction():
	"""Habilitar interacción con la carta"""
	interaction_enabled = true
	mouse_filter = Control.MOUSE_FILTER_STOP

func disable_interaction():
	"""Deshabilitar interacción con la carta"""
	interaction_enabled = false
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func highlight(enable: bool):
	"""Resaltar carta como jugable usando overlay"""
	if is_highlighted == enable:
		return  # Sin cambios
	
	is_highlighted = enable
	
	if highlight_overlay:
		highlight_overlay.visible = enable
		if enable:
			_start_highlight_pulse()
		else:
			_stop_highlight_pulse()

func _start_highlight_pulse():
	"""Iniciar animación de pulso para highlight"""
	_stop_highlight_pulse()  # Limpiar cualquier animación previa
	
	if not highlight_overlay:
		return
	
	highlight_tween = create_tween()
	highlight_tween.set_loops()
	highlight_tween.tween_property(highlight_overlay, "modulate:a", 0.3, 0.5)
	highlight_tween.tween_property(highlight_overlay, "modulate:a", 0.7, 0.5)

func _stop_highlight_pulse():
	"""Detener animación de pulso"""
	if highlight_tween:
		highlight_tween.kill()
		highlight_tween = null
	
	if highlight_overlay:
		# Restaurar al valor base del color original
		highlight_overlay.modulate.a = highlight_overlay.color.a

func set_disabled(disabled: bool):
	"""Deshabilitar visualmente la carta (estado lógico separado)"""
	if is_disabled == disabled:
		return
	
	is_disabled = disabled
	# No modificar interaction_enabled - separar input de lógica
	# interaction_enabled controla eventos, is_disabled controla drag/uso
	
	update_visual_state()

func set_exhausted(exhausted: bool):
	"""Marcar carta como exhausta (ya actuó este turno)"""
	if is_exhausted == exhausted:
		return
	
	is_exhausted = exhausted
	update_visual_state()

# ========================================
# MÉTODOS DE ANIMACIÓN
# ========================================

func play_select_animation():
	"""Animación al seleccionar la carta"""
	var tween = create_tween()
	tween.tween_property(self, "scale", Vector2(1.05, 1.05), 0.1).set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, "scale", Vector2.ONE, 0.1).set_trans(Tween.TRANS_CUBIC)

func play_hover_animation():
	"""Animación al pasar mouse (si HandLayout no la controla)"""
	if disable_hover_animation:
		return
	
	# Limpiar tween previo
	if hover_tween:
		hover_tween.kill()
	
	hover_tween = create_tween()
	hover_tween.set_trans(Tween.TRANS_CUBIC)
	hover_tween.set_ease(Tween.EASE_OUT)
	hover_tween.tween_property(self, "scale", Vector2(1.1, 1.1), 0.15)

func stop_hover_animation():
	"""Detener animación de hover"""
	if disable_hover_animation:
		return
	
	# Limpiar tween previo
	if hover_tween:
		hover_tween.kill()
	
	hover_tween = create_tween()
	hover_tween.set_trans(Tween.TRANS_CUBIC)
	hover_tween.set_ease(Tween.EASE_OUT)
	hover_tween.tween_property(self, "scale", Vector2.ONE, 0.15)

# ========================================
# STATE MACHINE METHODS (from DraggableObject)
# ========================================

## Safely transition between states with validation
func change_state(new_state: DraggableState) -> bool:
	if new_state == current_state:
		return true
	
	# Validate transition is allowed
	if not new_state in allowed_transitions[current_state]:
		print("[DBG] Invalid state transition: ", current_state, " → ", new_state)
		return false
	
	# Exit previous state
	_exit_state(current_state)
	
	var old_state = current_state
	current_state = new_state
	
	# Enter new state
	_enter_state(new_state, old_state)
	
	return true

## Handle state entry logic
func _enter_state(state: DraggableState, from_state: DraggableState) -> void:
	match state:
		DraggableState.IDLE:
			z_index = original_z
			mouse_filter = Control.MOUSE_FILTER_STOP
			
		DraggableState.HOVERING:
			z_index = original_z + 10
			_start_hover_animation()
			
		DraggableState.HOLDING:
			# Preserve hover position if coming from HOVERING
			if from_state == DraggableState.HOVERING:
				pass  # Position already maintained
			
			current_holding_mouse_position = get_local_mouse_position()
			z_index = original_z + 10
			rotation = 0
			
		DraggableState.MOVING:
			# Stop hover animations
			if hover_tween and hover_tween.is_valid():
				hover_tween.kill()
				hover_tween = null
			z_index = original_z + 10
			mouse_filter = Control.MOUSE_FILTER_IGNORE

## Handle state exit logic
func _exit_state(state: DraggableState) -> void:
	match state:
		DraggableState.HOVERING:
			z_index = original_z
			_stop_hover_animation()
			
		DraggableState.HOLDING:
			z_index = original_z
			scale = original_scale
			rotation = original_rotation
			
		DraggableState.MOVING:
			mouse_filter = Control.MOUSE_FILTER_STOP

## Process frame - handle HOLDING state mouse tracking
func _process(_delta: float) -> void:
	if current_state == DraggableState.HOLDING:
		global_position = get_global_mouse_position() - current_holding_mouse_position

## Helper for hover animation (internal use)
func _start_hover_animation() -> void:
	if disable_hover_animation:
		return
	
	# Limpiar tween previo
	if hover_tween:
		hover_tween.kill()
	
	hover_tween = create_tween()
	hover_tween.set_trans(Tween.TRANS_CUBIC)
	hover_tween.set_ease(Tween.EASE_OUT)
	hover_tween.tween_property(self, "scale", Vector2(hover_scale, hover_scale), hover_duration)
	hover_tween.tween_property(self, "position", Vector2(position.x, position.y - hover_distance), hover_duration)

## Helper to stop hover animation (internal use)
func _stop_hover_animation() -> void:
	if disable_hover_animation:
		return
	
	if hover_tween:
		hover_tween.kill()
	
	hover_tween = create_tween()
	hover_tween.set_trans(Tween.TRANS_CUBIC)
	hover_tween.set_ease(Tween.EASE_OUT)
	hover_tween.tween_property(self, "scale", original_scale, hover_duration)
	hover_tween.tween_property(self, "position", original_position, hover_duration)

# ========================================
# MÉTODOS DE GESTIÓN DE INSTANCIA
# ========================================

func bind_instance(instance: CardInstance):
	"""Vincular CardInstance a esta carta"""
	card_instance = instance
	if instance:
		instance_id = instance.instance_id

func unbind_instance():
	"""Desvincular CardInstance"""
	card_instance = null
	instance_id = ""

func get_instance() -> CardInstance:
	"""Obtener CardInstance vinculado"""
	return card_instance

func get_card_instance_id() -> String:
	"""Obtener ID de instancia"""
	return instance_id

# ========================================
# LIMPIEZA Y RESET
# ========================================

func reset_visuals():
	"""Resetear todos los estados visuales"""
	is_exhausted = false
	is_highlighted = false
	is_disabled = false
	modulate = Color(1, 1, 1, 1)
	scale = Vector2.ONE
	
	if card_image:
		card_image.rotation_degrees = 0
	
	if highlight_overlay:
		highlight_overlay.visible = false
	
	_stop_highlight_pulse()
	
	add_theme_stylebox_override("panel", normal_style)

func clear():
	"""Limpiar todos los datos de la carta (preparar para pooling)"""
	card_data = null
	unbind_instance()
	reset_visuals()
	
	# Liberar textura para pooling
	if card_image:
		card_image.texture = null

func _notification(what):
	if what == NOTIFICATION_DRAG_END:
		var _dbg_name_drag_end := card_data.name if card_data else ""
		print("[DBG] CardDisplay: drag_ended | card=", _dbg_name_drag_end, " instance=", instance_id)
		drag_ended.emit(self)
		
		# CAMBIO: Restaurar carta a estado original después del drag
		_restore_card_after_drag()

func safe_cleanup():
	"""Limpieza segura antes de eliminar la carta"""
	if is_instance_valid(self):
		# Matar tweens activos
		_stop_highlight_pulse()
		if hover_tween:
			hover_tween.kill()
			hover_tween = null
		
		# Desconectar señales
		if gui_input.is_connected(_on_gui_input):
			gui_input.disconnect(_on_gui_input)
		
		# Detener timer
		if click_timer and is_instance_valid(click_timer):
			if click_timer.timeout.is_connected(_on_click_timeout):
				click_timer.timeout.disconnect(_on_click_timeout)
			click_timer.stop()
		
		# No llamar clear() - permitir reciclaje del nodo en pools
